# TeamSync environment template (spec §J.7).
# Copy to `.env.local` and fill in. Never commit real values.

# --- Public (shipped to the browser; safe only because RLS protects every table) ---
# Supabase project URL, e.g. http://127.0.0.1:54321 for `supabase start`
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (or the newer "publishable" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URL of the app, used for auth redirects and invite links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Show "Continue with Google" only when a Google OAuth client is configured in Supabase
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Service-role (or "secret") key — used ONLY by /api/cron/* and account deletion
SUPABASE_SERVICE_ROLE_KEY=
# >= 32 random characters; also stored as a GitHub Actions secret for the daily workflow
CRON_SECRET=
# Optional — absent means AI features use deterministic rule-based fallbacks
GEMINI_API_KEY=
# Optional — a currently free-tier Flash / Flash-Lite model name (verify at deploy time)
GEMINI_MODEL=
# Optional — global cap on AI requests per day (default 200)
AI_GLOBAL_DAILY_LIMIT=
# Optional — timezone used by cron snapshots (default Asia/Kolkata)
APP_DEFAULT_TZ=
